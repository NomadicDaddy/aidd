#!/bin/sh
# Fast pre-commit gate: leak-guard + `bun run smoke:qc:fast`.
#
# leak-guard scans the staged index diff, so it is uncacheable-by-design and runs first as a
# security gate. The static checks that follow are delegated to `smoke:qc:fast`, each repository's
# own no-tests subset of smoke:qc — content-hash cached and ordered by ascending cost/failure rate
# where the repository implements it that way, so a doomed commit fails on the cheapest failing
# check first. The full smoke:qc (tests, builds, and the remaining static checks) still runs in CI.
#
# This hook depends on a script-name contract, not on any repository's internals: every repo that
# installs it defines `smoke:qc:fast` and `check:licenses` in package.json (the manifest's
# requiresScripts for this hook; the leak guard itself runs as .githooks/leak-guard.sh) and
# is free to implement them differently. That is what lets this file stay byte-identical while the
# repositories diverge — a repo with no third-party inventory to verify may legitimately define
# `check:licenses` as the license core alone.
#
# Bypass with `git commit --no-verify` only for WIP/experimental commits
# or confirmed false positives.
#
# smokestack owns this file and delivers it with `bun run shared-core:write`. Change it in
# smokestack; every repository that takes it holds a byte-identical copy.

# Find bash by absolute path and put its directory first, then start over under it. Looking bash up
# on PATH is what broke this hook: on Windows System32 holds the WSL launcher under the same name,
# and a session whose PATH lists System32 ahead of Git's tools ran that, which fails with
# `execvpe(/bin/bash)`. A hook that fails every commit gets bypassed, and the leak guard goes with
# it. `/usr/bin/bash` is Git's own bash on Windows and the system's on Linux; `/bin/bash` covers
# macOS. With that directory first, every `bash`, `grep`, and `sort` below is the right one too.
if [ -z "${GITHOOK_BASH_RESOLVED:-}" ]; then
	for hook_bash in /usr/bin/bash /bin/bash; do
		if [ -x "$hook_bash" ]; then
			GITHOOK_BASH_RESOLVED=1
			PATH="${hook_bash%/*}:$PATH"
			export GITHOOK_BASH_RESOLVED PATH
			exec "$hook_bash" "$0" "$@"
		fi
	done
	echo "x pre-commit: no bash at /usr/bin/bash or /bin/bash, so the guards cannot run." >&2
	exit 1
fi
# Cleared so a git command run from inside this hook resolves bash for its own hooks afresh.
unset GITHOOK_BASH_RESOLVED

set -euo pipefail

echo "pre-commit: leak-guard"
bash .githooks/leak-guard.sh

echo "pre-commit: qc (cached subset of smoke:qc)"
bun run smoke:qc:fast

# The license checks read bun.lock and the installed tree — the third-party inventory is generated
# FROM the lockfile — so a dependency change can break them without touching a single source file.
# check:licenses is not in the fast subset, so nothing local catches that; it has reached main more
# than once and surfaced only in a later full smoke:qc. Gate it here, but only when a dependency
# manifest is actually staged, so ordinary commits pay nothing for it.
#
# Read into a variable rather than piping into grep: under `set -o pipefail` a matching `grep -q`
# can still fail the pipeline when it closes the pipe early and git takes SIGPIPE, which would
# silently skip the check on exactly the commits that need it.
staged_files=$(git diff --cached --name-only --diff-filter=ACMR)
if grep -qE '(^|/)(bun\.lock|package\.json)$' <<<"$staged_files"; then
	echo "pre-commit: check:licenses (dependency manifest staged)"
	bun run check:licenses
fi

echo "pre-commit: passed"
