#!/bin/sh
# Thin wrapper: the guards own the logic, this owns only the wiring.
#
# git passes the remote name/URL as $1/$2 and the ref updates on stdin. Stdin is captured once
# and replayed into each guard, because a guard that reads it would otherwise starve the next.
#
# If a repository grows its own pre-push checks, chain them here rather than replacing this file —
# core.hooksPath allows exactly one pre-push, so an overwrite silently disables the guards.

# Find bash by absolute path and put its directory first, then start over under it. Looking bash up
# on PATH is what broke the pre-commit hook: on Windows System32 holds the WSL launcher under the
# same name, and a session whose PATH lists System32 ahead of Git's tools ran that, which fails
# with `execvpe(/bin/bash)`. A guard that fails every push gets bypassed. `/usr/bin/bash` is Git's
# own bash on Windows and the system's on Linux; `/bin/bash` covers macOS. Stdin is untouched by
# the restart, so the ref updates git sends are still there to read below.
if [ -z "${GITHOOK_BASH_RESOLVED:-}" ]; then
	for hook_bash in /usr/bin/bash /bin/bash; do
		if [ -x "$hook_bash" ]; then
			GITHOOK_BASH_RESOLVED=1
			PATH="${hook_bash%/*}:$PATH"
			export GITHOOK_BASH_RESOLVED PATH
			exec "$hook_bash" "$0" "$@"
		fi
	done
	echo "x pre-push: no bash at /usr/bin/bash or /bin/bash, so the guards cannot run." >&2
	exit 1
fi
# Cleared so a git command run from inside this hook resolves bash for its own hooks afresh.
unset GITHOOK_BASH_RESOLVED

set -euo pipefail

hooks_dir="$(dirname "$0")"
refs="$(cat)"

echo "pre-push: force-push guard"
printf '%s\n' "$refs" | bash "$hooks_dir/force-push-guard.sh"

echo "pre-push: aidd history guard"
printf '%s\n' "$refs" | bash "$hooks_dir/aidd-history-guard.sh" "${1:-origin}"

echo "pre-push: screenshot guard"
printf '%s\n' "$refs" | bash "$hooks_dir/screenshot-guard.sh"

echo "pre-push: passed"
