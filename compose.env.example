# Copy to compose.env (gitignored). Container env reaches launched agent CLIs
# only when allowlisted in shared/src/subprocess-env.ts — anything else is
# silently dropped. Subscription auth (Claude Pro/Max, ChatGPT plans) needs no
# keys here: `docker exec -it <container> claude /login` once instead; the
# credentials persist in the home volume.

# claude-code backend (and native backend default provider)
ANTHROPIC_API_KEY=

# codex backend
OPENAI_API_KEY=

# Optional providers
#ZHIPU_API_KEY=
#XAI_API_KEY=
#NATIVE_PROVIDER=
#NATIVE_API_KEY=
#NATIVE_BASE_URL=
#NATIVE_MODEL=

# Entrypoint-only (never reach app code): git identity for run commits.
GIT_USER_NAME=
GIT_USER_EMAIL=
