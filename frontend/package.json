{
	"name": "aidd-frontend",
	"private": true,
	"packageManager": "bun@1.4.3",
	"engines": {
		"bun": ">=1.4.3"
	},
	"dependencies": {
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@fontsource-variable/space-grotesk": "5.3.0",
		"@tanstack/react-query": "5.105.0",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/addon-search": "0.16.0",
		"@xterm/addon-web-links": "0.12.0",
		"@xterm/addon-webgl": "0.19.0",
		"@xterm/xterm": "6.0.0",
		"aidd-shared": "workspace:*",
		"cmdk": "1.1.1",
		"lucide-react": "1.66.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-router": "8.5.1",
		"sonner": "2.0.8",
		"tailwind-merge": "3.7.0",
		"web-vitals": "6.2.3",
		"zustand": "5.0.16"
	},
	"devDependencies": {
		"@rolldown/plugin-babel": "0.3.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"babel-plugin-react-compiler": "1.0.0",
		"rollup-plugin-visualizer": "7.1.1",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.3.5"
	},
	"scripts": {
		"build": "bunx tsc -p tsconfig.json && bunx vite build",
		"build:analyze": "AIDD_BUILD_ANALYZE=1 bunx vite build",
		"dev": "bunx vite --host",
		"lint": "bunx eslint . --report-unused-disable-directives --max-warnings 0",
		"lint:fast": "bunx eslint . --cache --cache-location ../node_modules/.cache/eslint-frontend/ --report-unused-disable-directives --max-warnings 0",
		"lint:fix": "bunx eslint . --report-unused-disable-directives --max-warnings 0 --fix",
		"preinstall": "bun ../scripts/require-bun.ts",
		"typecheck": "bunx tsc -p tsconfig.json --noEmit"
	},
	"type": "module"
}
