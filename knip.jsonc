{
	"$schema": "https://unpkg.com/knip@latest/schema.json",
	"ignoreExportsUsedInFile": true,
	"includeEntryExports": true,
	"rules": {
		"enumMembers": "off",
		"exports": "error",
		"types": "error",
	},
	"workspaces": {
		".": {
			"entry": ["scripts/*.ts", "test/**/*.test.ts"],
			"ignoreBinaries": ["taskkill", "netstat", "lsof", "pwsh"],
			// Knip's binary scanner treats these Bun spawn arguments as unresolved imports.
			// Both targets are real entry scripts and are also covered by the project glob.
			"ignoreUnresolved": ["scripts/check-image-licenses.ts", "scripts/run-benchmark.ts"],
			"project": ["scripts/**/*.ts", "test/**/*.ts"],
		},
		"backend": {
			"entry": ["src/server.ts"],
			"project": ["src/**/*.ts"],
		},
		"cli": {
			"entry": ["src/app.ts"],
			"project": ["src/**/*.ts"],
		},
		"frontend": {
			"entry": ["src/App.tsx"],
			"ignore": ["src/components/ui/*.tsx"],
			// Knip resolves JS import specifiers but not CSS url() targets. The Geist faces
			// are referenced only from src/fonts.css, which declares @font-face by hand
			// rather than importing the packages' own stylesheets.
			"ignoreDependencies": [
				"@fontsource-variable/geist",
				"@fontsource-variable/geist-mono",
				"tailwindcss",
			],
			"ignoreIssues": {
				// Inputs and selects deliberately share the same base classes under semantic aliases.
				"src/lib/formStyles.ts": ["duplicates"],
			},
			"project": ["src/**/*.{ts,tsx}"],
		},
		"shared": {},
	},
}
