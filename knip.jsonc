{
	"$schema": "https://unpkg.com/knip@latest/schema.json",
	"ignoreExportsUsedInFile": true,
	"ignoreIssues": {
		// Shared verbatim with Spernakit, whose setup branding pass consumes
		// commandFileReferences. Preserve the owner's exported API here.
		"scripts/check-script-targets.ts": ["exports"],
	},
	"includeEntryExports": true,
	"rules": {
		"enumMembers": "off",
		"exports": "error",
		"types": "error",
	},
	"workspaces": {
		".": {
			"entry": ["scripts/*.ts", "test/**/*.test.ts"],
			"ignoreBinaries": ["netstat"],
			// Knip's binary scanner treats this Bun spawn argument as an unresolved import. The
			// target is a real entry script and is also covered by the project glob.
			"ignoreUnresolved": ["scripts/run-benchmark.ts"],
			"project": ["scripts/**/*.ts", "test/**/*.ts"],
		},
		"backend": {
			"entry": ["src/server.ts"],
			"project": ["src/**/*.ts"],
		},
		"cli": {
			"entry": ["src/app.ts"],
			"project": ["src/**/*.ts"],
		},
		"frontend": {
			"entry": ["src/App.tsx"],
			// Knip resolves JS import specifiers but not CSS url() targets. The Geist faces
			// are referenced only from src/fonts.css, which declares @font-face by hand
			// rather than importing the packages' own stylesheets.
			"ignoreDependencies": ["@fontsource-variable/geist", "@fontsource-variable/geist-mono"],
			"project": ["src/**/*.{css,ts,tsx}"],
		},
		"shared": {},
	},
}
