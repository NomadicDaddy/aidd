{
	"name": "aidd",
	"version": "3.0.2",
	"private": true,
	"author": "NomadicDaddy",
	"bugs": {
		"url": "https://github.com/NomadicDaddy/aidd/issues"
	},
	"description": "AI Development Director - your local control panel for planning, running, and auditing AI coding work.",
	"dependencies": {
		"aidd-shared": "workspace:*"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/bun": "1.4.2",
		"@types/node": "26.6.2",
		"drizzle-orm": "0.45.2",
		"elysia": "1.4.30",
		"eslint": "10.11.0",
		"eslint-plugin-jsdoc": "64.5.4",
		"eslint-plugin-perfectionist": "5.11.1",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-react-refresh": "0.5.7",
		"eslint-plugin-unused-imports": "4.4.1",
		"globals": "17.12.0",
		"knip": "6.37.0",
		"prettier": "^3.9.8",
		"prettier-plugin-organize-attributes": "1.0.0",
		"prettier-plugin-sort-json": "4.2.0",
		"prettier-plugin-tailwindcss": "0.8.1",
		"puppeteer": "25.11.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.0"
	},
	"engines": {
		"bun": ">=1.4.2"
	},
	"homepage": "https://github.com/NomadicDaddy/aidd#readme",
	"keywords": [
		"agents",
		"ai",
		"autonomous",
		"claude",
		"claude-code",
		"cline",
		"coding",
		"codex-cli",
		"developer-tools",
		"kilocode",
		"opencode",
		"orchestration",
		"zai"
	],
	"license": "FSL-1.1-ALv2",
	"packageManager": "bun@1.4.2",
	"repository": {
		"type": "git",
		"url": "https://github.com/NomadicDaddy/aidd.git"
	},
	"scripts": {
		"aidd-tools": "bun scripts/aidd-tools.ts",
		"audit:dependencies": "bun audit",
		"benchmark": "bun scripts/run-benchmark.ts --manifest ./benchmarks/manifest.json",
		"benchmark:dry-run": "bun scripts/run-benchmark.ts --manifest ./benchmarks/manifest.json --dry-run",
		"benchmark:regrade": "bun scripts/run-benchmark.ts --manifest ./benchmarks/manifest.json --regrade",
		"benchmark:report": "bun scripts/run-benchmark.ts --manifest ./benchmarks/manifest.json --report-only",
		"bench:audits": "bun scripts/run-audit-evals.ts",
		"build": "bun run build:shared && bun run build:backend && bun run build:cli && bun run build:frontend",
		"build:backend": "bun run --cwd backend build",
		"build:cli": "bun run --cwd cli build",
		"build:frontend": "bun run --cwd frontend build",
		"build:analyze": "bun run --cwd frontend build:analyze && bun run check:bundle-analysis",
		"build:shared": "bun run --cwd shared build",
		"check-application": "bun scripts/check-application.ts",
		"check:api-types": "bun scripts/check-api-types.ts",
		"check:audit-evals": "bun scripts/check-audit-evals.ts",
		"check-deps": "bun scripts/check-deps.ts",
		"check:artifact-parity": "bun scripts/check-artifact-parity.ts",
		"check:bundle-analysis": "bun scripts/check-bundle-analysis.ts",
		"check:fleet": "bun scripts/check-fleet-aidd-entries.ts && bun scripts/check-fleet-aidd-history.ts && bun scripts/check-fleet-hook-wiring.ts",
		"check:fleet-aidd-entries": "bun scripts/check-fleet-aidd-entries.ts",
		"check:fleet-aidd-history": "bun scripts/check-fleet-aidd-history.ts",
		"check:fleet-hook-wiring": "bun scripts/check-fleet-hook-wiring.ts",
		"check:audit-artifact-hygiene": "bun scripts/check-audit-artifact-hygiene.ts",
		"check:backend-cli-boundary": "bun scripts/check-backend-cli-boundary.ts",
		"check:credential-disclosure": "bun scripts/check-credential-disclosure.ts",
		"check:critical-path": "bun scripts/check-critical-path.ts",
		"check:dead-code": "bunx knip",
		"check:destructive-confirmation": "bun scripts/check-destructive-confirmation.ts",
		"check:docs": "bun scripts/check-docs.ts",
		"check:audit-profile-mapping": "bun scripts/aidd-tools.ts audit:profile-mapping",
		"check:env-spread": "bun scripts/check-env-spread.ts",
		"check:fresh-release": "bun scripts/check-fresh-release.ts",
		"check:git-window-hide": "bun scripts/check-git-window-hide.ts",
		"check:feature-integration": "bun scripts/check-feature-integration.ts",
		"check:gate-conventions": "bun scripts/check-gate-conventions.ts",
		"check:hook-parity": "bun scripts/check-hook-parity.ts",
		"check:leak-guard": "bun ./scripts/run-bash.ts scripts/check-leak-guard.sh",
		"check:license-core": "bun scripts/check-license-core.ts",
		"check:licenses": "bun run check:license-core && bun scripts/generate-third-party-licenses.ts --check",
		"check:media-provenance": "bun scripts/check-media-provenance.ts",
		"check:max-lines": "bun scripts/check-max-lines.ts",
		"check:no-inline-references": "bun scripts/check-no-inline-references.ts",
		"check:scaffold": "bun scripts/check-scaffold.ts",
		"check:version-parity": "bun scripts/release-notes.ts --check",
		"check:schema-parity": "bun scripts/check-schema-parity.ts",
		"check:script-targets": "bun scripts/check-script-targets.ts",
		"check:shared-core": "bun scripts/sync-shared-core.ts --check",
		"check:source-install": "bun scripts/check-source-install.ts",
		"check:smoke-docs": "bun scripts/sync-smoke-docs.ts --check",
		"check:web-db-integrity": "bun scripts/check-web-db-integrity.ts",
		"crawltest": "bun scripts/crawltest-run.ts",
		"crawltest:analyze": "bun scripts/crawltest-analyze.ts",
		"crawltest:bug": "bun scripts/crawltest.ts --bug",
		"crawltest:page": "bun scripts/crawltest.ts --page",
		"deploy": "echo 'No deploy command is configured for this local target. See .aidd/deployment.md.' && exit 1",
		"dev:backend": "bun run --cwd backend dev",
		"dev:frontend": "bun run --cwd frontend dev",
		"dev:web": "bun run stop:web && bun run dev:backend",
		"format": "prettier --write . --cache --cache-location node_modules/.cache/prettier/",
		"format:check": "prettier --check . --cache --cache-location node_modules/.cache/prettier/",
		"lint": "bun scripts/run-lint.ts",
		"lint:cli": "bunx eslint cli/src --report-unused-disable-directives --max-warnings 0",
		"lint:cli:fast": "bunx eslint cli/src --cache --cache-location node_modules/.cache/eslint-cli/ --report-unused-disable-directives --max-warnings 0",
		"lint:cli:fix": "bunx eslint cli/src --report-unused-disable-directives --max-warnings 0 --fix",
		"lint:config": "bunx eslint eslint.config.js --report-unused-disable-directives --max-warnings 0",
		"lint:config:fast": "bunx eslint eslint.config.js --cache --cache-location node_modules/.cache/eslint-config/ --report-unused-disable-directives --max-warnings 0",
		"lint:config:fix": "bunx eslint eslint.config.js --report-unused-disable-directives --max-warnings 0 --fix",
		"lint:fast": "bun scripts/run-lint.ts --fast",
		"lint:fix": "bun run --cwd shared lint:fix && bun run --cwd backend lint:fix && bun run --cwd frontend lint:fix && bun run lint:scripts:fix && bun run lint:cli:fix && bun run lint:test:fix && bun run lint:config:fix",
		"lint:scripts": "bunx eslint scripts --report-unused-disable-directives --max-warnings 0",
		"lint:scripts:fast": "bunx eslint scripts --cache --cache-location node_modules/.cache/eslint-scripts/ --report-unused-disable-directives --max-warnings 0",
		"lint:scripts:fix": "bunx eslint scripts --report-unused-disable-directives --max-warnings 0 --fix",
		"lint:test": "bunx eslint test --report-unused-disable-directives --max-warnings 0",
		"lint:test:fast": "bunx eslint test --cache --cache-location node_modules/.cache/eslint-test/ --report-unused-disable-directives --max-warnings 0",
		"lint:test:fix": "bunx eslint test --report-unused-disable-directives --max-warnings 0 --fix",
		"licenses:generate": "bun scripts/generate-third-party-licenses.ts",
		"preinstall": "bun scripts/require-bun.ts",
		"postinstall": "bun scripts/postinstall.ts",
		"install:history-guard": "bun scripts/install-history-guard.ts",
		"install:leak-guard": "bun scripts/install-leak-guard.ts",
		"prepare": "bun scripts/prepare.ts --setup \"bun ./scripts/run-bash.ts .githooks/leak-guard-setup.sh\"",
		"prompt:snapshot": "bun run --cwd cli prompt:snapshot",
		"prompt:snapshot:check": "bun run --cwd cli prompt:snapshot:check",
		"release:notes": "bun scripts/release-notes.ts",
		"qc:status": "bun scripts/smoke-qc.ts --cache-status",
		"self-contained": "bun scripts/self-contained.ts",
		"smoke:backends": "bun scripts/smoke-backends.ts",
		"smoke:dev": "bun run smoke:e2e",
		"smoke:docs": "bun scripts/sync-smoke-docs.ts",
		"smoke:e2e": "bun scripts/smoke-e2e.ts",
		"smoke:qc": "bun scripts/smoke-qc.ts",
		"smoke:qc:fast": "bun scripts/smoke-qc.ts --fast",
		"smoke:screenshots": "bun scripts/smoke-web.ts --screenshot-pages",
		"smoke:web": "bun scripts/smoke-web.ts",
		"start:web": "bun scripts/start-web.ts",
		"stop": "bun run stop:web",
		"stop:web": "bun scripts/stop-web.ts",
		"start": "bun run --cwd cli start",
		"test": "bun scripts/run-tests.ts",
		"test:coverage": "bun scripts/run-test-coverage.ts",
		"test:credential-disclosure": "bun scripts/test-credential-disclosure.ts",
		"test:gate-conventions": "bun scripts/test-gate-conventions.ts",
		"test:api-types": "bun scripts/test-api-types.ts",
		"test:audit-evals": "bun scripts/test-audit-evals.ts",
		"test:media-provenance": "bun scripts/test-media-provenance.ts",
		"verify-minification": "bun scripts/verify-minification.ts",
		"typecheck": "tsc --noEmit && bun run --cwd frontend typecheck"
	},
	"type": "module",
	"workspaces": [
		"backend",
		"cli",
		"frontend",
		"shared"
	]
}
