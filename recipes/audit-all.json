{
	"description": "Run all audits, review findings, and review features.",
	"name": "audit (all)",
	"parameters": [
		{
			"description": "Target application name",
			"name": "application"
		}
	],
	"steps": [
		{
			"configJson": {
				"auditAll": true,
				"maxIterations": 3
			},
			"name": "Run all audits",
			"stepType": "aidd-cli"
		},
		{
			"configJson": {
				"args": "{application}",
				"executionIntent": "apply-changes",
				"skillId": "audit-finding-review"
			},
			"name": "Review audit findings",
			"stepType": "skill"
		},
		{
			"configJson": {
				"args": "{application}",
				"executionIntent": "apply-changes",
				"skillId": "feature-review"
			},
			"name": "Review features",
			"stepType": "skill"
		}
	]
}
