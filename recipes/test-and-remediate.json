{
	"description": "Test application, convert bugs to features, remediate, and produce session report.",
	"name": "test and remediate",
	"parameters": [
		{
			"description": "Target application name",
			"name": "application"
		}
	],
	"steps": [
		{
			"configJson": {
				"args": "{application}",
				"executionIntent": "apply-changes",
				"skillId": "tester"
			},
			"name": "Test application",
			"stepType": "skill"
		},
		{
			"configJson": {
				"args": "{application}",
				"executionIntent": "apply-changes",
				"skillId": "bug2feature"
			},
			"name": "Convert bugs to features",
			"stepType": "skill"
		},
		{
			"configJson": {
				"args": "{application}",
				"executionIntent": "apply-changes",
				"skillId": "feature-review"
			},
			"name": "Review features",
			"stepType": "skill"
		},
		{
			"configJson": {
				"params": {
					"application": "{application}"
				},
				"recipeName": "remediate bugs"
			},
			"name": "Remediate bugs",
			"stepType": "recipe-ref"
		},
		{
			"configJson": {
				"maxIterations": 1,
				"prompt": "Create a session report at {application}/.aidd/reports/ with a timestamp filename. Include: time taken for each step, summary of bugs found, features created, remediations applied, and any issues encountered."
			},
			"name": "Create session report",
			"stepType": "aidd-cli"
		}
	]
}
