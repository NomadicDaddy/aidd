*.pre-crawl-bak
*.tsbuildinfo
artifacts/
crawltest.json
devdocs/
dogfood-output/
screenshots/
scripts/*-error.png
scripts/smoke-cache.json
test-html-report/
test-results/
testResults.xml
upgrade-review/

