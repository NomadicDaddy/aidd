.env

# tooling/caches
.worktrees/
node_modules/
ps_modules/

# aidd / agent-generated artifacts
#
# Derived from the artifact catalog in docs/reference/artifacts.md: this block lists exactly the
# rows classed runtime/generated/secret, and nothing else. Everything else under .aidd/ is
# a durable blueprint and is committed on purpose. Add a row there before adding a rule here.
.agents/

# generated — reproducible by re-running the producer
.aidd/_common/
.aidd/.artifacts-check.json
.aidd/audit-reports/
.aidd/audits/
.aidd/feature-review-report.md
.aidd/remediation-review.md
.aidd/reports/
.aidd/response-review.md

# runtime — meaningful only for the run that wrote it
.aidd/active-runs/
.aidd/iterations/
.aidd/runs.jsonl
.aidd/.stop

# secret — holds provider API keys, web.authToken, botToken; never commit
.aidd/aidd.config.json

.claude/
.codex/
.windsurf/
AGENTS.md
CLAUDE.md
opencode.json

